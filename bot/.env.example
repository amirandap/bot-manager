# Bot Instance Environment Configuration

# Bot Identification
BOT_ID=whatsapp-bot-1
BOT_NAME=WhatsApp Bot 1
BOT_TYPE=whatsapp
BOT_PORT=7260

# WhatsApp Configuration
FALLBACKNUMBER=+10000000000

# Server Configuration
BASE_URL=http://localhost:7260
PORT=7260

# Chrome/Puppeteer Configuration (for WhatsApp Web)
CHROME_PATH=/usr/bin/google-chrome

# Private user-directory API (no trailing path)
USER_API_BASE_URL=https://api.example.com

# Email Configuration (for notifications)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password
MAIL_RECIPIENT=recipient@example.com
