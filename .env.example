# Bot Manager environment template.
# Copy to .env and replace the placeholders. Never commit .env.
#
#   cp .env.example .env
#
# Bot-instance secrets (fallback number, Gmail, private user API)
# belong in bot/.env. See bot/.env.example.

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development

# =============================================================================
# SERVER PORTS
# =============================================================================
BACKEND_PORT=3001
FRONTEND_PORT=7260
BOT_PORT_START=7261

# =============================================================================
# SERVER HOSTS
# =============================================================================
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
SERVER_HOST=127.0.0.1

# =============================================================================
# API URLS
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:7260
FALLBACK_API_HOST=http://localhost

# =============================================================================
# BOT MANAGEMENT
# =============================================================================
BOT_CONFIG_PATH=./config/bots.json
DEFAULT_BOT_HOST=localhost
CHROME_PATH=/usr/bin/google-chrome-stable

# WhatsApp API base URLs used by the backend. Leave blank if unused.
WAPI_URL=https://wapi.example.com
WAPI_URL2=https://wapi-backup.example.com

# =============================================================================
# LOGGING AND DEVELOPMENT
# =============================================================================
LOG_LEVEL=info
DEV_MODE=true
VERBOSE_SPAWNING=false
HEALTH_CHECK_ENABLED=true

# Legacy aliases. The backend reads PORT.
PORT=3001

# =============================================================================
# SECRETS
# Generate new random values locally. Do not reuse anything from git history.
# =============================================================================
WEBHOOK_SECRET=replace-with-a-random-string
JWT_SECRET=replace-with-a-random-string
DB_ENCRYPTION_KEY=replace-with-a-random-string
